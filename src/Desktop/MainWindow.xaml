<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Codex Proxy" Width="1100" Height="760" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style x:Key="NavLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Style>
  </Window.Resources>
  <Border BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Canvas}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Background="{DynamicResource Sidebar}">
        <TextBlock Text="Codex Proxy" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" Margin="18,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Style="{StaticResource GhostButton}" Width="44" Height="38" Padding="0" ToolTip="最小化" AutomationProperties.Name="最小化窗口">
            <Path Data="M0,5 L10,5" Stroke="{DynamicResource Secondary}" StrokeThickness="1"/>
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource GhostButton}" Width="44" Height="38" Padding="0" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原窗口">
            <Path Data="M0,0 L9,0 9,9 0,9 Z" Stroke="{DynamicResource Secondary}" StrokeThickness="1"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Width="44" Height="38" Padding="0" ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口">
            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource Secondary}" StrokeThickness="1.2"/>
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="210"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <Grid Margin="12,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="72"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="8,6,0,0" VerticalAlignment="Top">
              <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Accent}">
                <TextBlock Text="C" FontFamily="Segoe UI" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
              </Border>
              <StackPanel x:Name="BrandCaption" Margin="10,0,0,0">
                <TextBlock Text="Codex Proxy" FontSize="15" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                <TextBlock Text="MULTI APP LAUNCHER" FontFamily="Segoe UI" FontSize="8" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1">
              <TextBlock x:Name="WorkspaceCaption" Text="工作空间" Style="{StaticResource Caption}" FontSize="10" Margin="12,0,0,9"/>
              <RadioButton x:Name="OverviewNav" Style="{StaticResource Nav}" GroupName="navigation" Command="{Binding NavigateCommand}" CommandParameter="overview" IsChecked="{Binding SelectedPage, Converter={StaticResource Equal}, ConverterParameter=overview, Mode=OneWay}" ToolTip="代理启动 · Alt+1" AutomationProperties.Name="代理启动">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource NavIcon}" Data="{StaticResource IHome}"/>
                  <TextBlock Text="代理启动" Style="{StaticResource NavLabel}"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="DiagnosticsNav" Style="{StaticResource Nav}" GroupName="navigation" Command="{Binding NavigateCommand}" CommandParameter="diagnostics" IsChecked="{Binding SelectedPage, Converter={StaticResource Equal}, ConverterParameter=diagnostics, Mode=OneWay}" ToolTip="运行诊断 · Alt+2" AutomationProperties.Name="运行诊断">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource NavIcon}" Data="{StaticResource IShield}"/>
                  <TextBlock Text="运行诊断" Style="{StaticResource NavLabel}"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ApplicationsNav" Style="{StaticResource Nav}" GroupName="navigation" Command="{Binding NavigateCommand}" CommandParameter="applications" IsChecked="{Binding SelectedPage, Converter={StaticResource Equal}, ConverterParameter=applications, Mode=OneWay}" ToolTip="应用管理 · Alt+5" AutomationProperties.Name="应用管理">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource NavIcon}" Data="{StaticResource IMonitor}"/>
                  <TextBlock Text="应用管理" Style="{StaticResource NavLabel}"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="LogsNav" Style="{StaticResource Nav}" GroupName="navigation" Command="{Binding NavigateCommand}" CommandParameter="logs" IsChecked="{Binding SelectedPage, Converter={StaticResource Equal}, ConverterParameter=logs, Mode=OneWay}" ToolTip="运行日志 · Alt+3" AutomationProperties.Name="运行日志">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource NavIcon}" Data="{StaticResource ILog}"/>
                  <TextBlock Text="运行日志" Style="{StaticResource NavLabel}"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
              <Border Height="1" Background="{DynamicResource Line}" Margin="8,0,8,10"/>
              <RadioButton x:Name="SettingsNav" Style="{StaticResource Nav}" GroupName="navigation" Command="{Binding NavigateCommand}" CommandParameter="settings" IsChecked="{Binding SelectedPage, Converter={StaticResource Equal}, ConverterParameter=settings, Mode=OneWay}" ToolTip="设置 · Alt+4" AutomationProperties.Name="设置">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource NavIcon}" Data="{StaticResource ISettings}"/>
                  <TextBlock Text="设置" Style="{StaticResource NavLabel}"/>
                </StackPanel>
              </RadioButton>
              <Grid Margin="8,15,4,0">
                <TextBlock x:Name="SidebarVersion" Text="{Binding Version, StringFormat=v{0}}" Style="{StaticResource Caption}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Button Style="{StaticResource GhostButton}" Command="{Binding CollapseCommand}" Width="30" Height="28" MinHeight="0" Padding="6" HorizontalAlignment="Right" ToolTip="展开或收起侧栏" AutomationProperties.Name="展开或收起侧栏">
                  <Path Style="{StaticResource Icon}" Data="{StaticResource ICollapse}" Width="15" Height="15"/>
                </Button>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
          </Grid.RowDefinitions>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="ApplicationSelector" Width="185" ItemsSource="{Binding Applications}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedApplication}" IsEnabled="{Binding CanChangeApplication}" AutomationProperties.Name="当前代理应用" ToolTip="切换需要通过代理启动的应用"/>
                <TextBlock x:Name="HeaderSubtitle" Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="12,3,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" ToolTip="重新检测 · F5" AutomationProperties.Name="重新检测">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource Icon}" Data="{StaticResource IRefresh}" Width="14" Height="14"/>
                  <TextBlock Text="重新检测" FontSize="12" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <ProgressBar Grid.Row="1" VerticalAlignment="Top" Height="2" IsIndeterminate="True" Visibility="{Binding IsWorking, Converter={StaticResource BoolVisible}}" Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0" Panel.ZIndex="5"/>
          <Grid Grid.Row="1">
            <ScrollViewer x:Name="OverviewPage" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=overview}" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="30,28,30,30" MaxWidth="1040">
                <Grid Margin="0,0,0,20">
                  <StackPanel>
                    <TextBlock Text="代理启动" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ApplicationCaption}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                  </StackPanel>
                  <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                    <TextBlock Text="{Binding StatusBadge}" Style="{StaticResource StatusText}"/>
                  </Border>
                </Grid>
                <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Accent}" Padding="24,20" Margin="0,0,0,20">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentSoft}" Margin="0,0,15,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IPlug}" Stroke="{DynamicResource Accent}" Width="25" Height="25"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="本地 HTTP 代理" FontSize="12" Foreground="{DynamicResource Secondary}"/>
                        <TextBlock Text="{Binding ProxyEndpoint}" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/>
                      </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,19,0,18"/>
                    <TextBlock Text="{Binding StatusTitle}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusDescription}" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" LineHeight="22" Margin="0,9,0,22"/>
                    <WrapPanel>
                      <Button x:Name="LaunchButton" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}" Padding="22,12" Height="44" MinWidth="160" AutomationProperties.Name="{Binding LaunchLabel}" ToolTip="通过代理启动当前应用 · Ctrl+Enter">
                        <StackPanel Orientation="Horizontal">
                          <Path Style="{StaticResource Icon}" Data="{StaticResource IPlay}" Stroke="{DynamicResource OnAccent}" Width="15" Height="15"/>
                          <TextBlock Text="{Binding LaunchLabel}" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" Margin="9,0,0,0"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="EditApplicationButton" Style="{StaticResource GhostButton}" Command="{Binding EditApplicationCommand}" Height="44" Margin="10,0,0,0" Content="应用设置"/>
                      <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="settings" Height="44" Margin="4,0,0,0" Content="默认代理"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Grid Margin="0,0,0,11">
                  <TextBlock Text="连接概况" FontWeight="SemiBold" FontSize="14"/>
                  <Button Command="{Binding NavigateCommand}" CommandParameter="diagnostics" Style="{StaticResource GhostButton}" Padding="0" MinHeight="20" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="查看诊断" Foreground="{DynamicResource Secondary}" FontSize="12"/>
                      <Path Style="{StaticResource Icon}" Data="{StaticResource IArrow}" Width="12" Height="12" Margin="7,0,0,0"/>
                    </StackPanel>
                  </Button>
                </Grid>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Margin="18,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IPlug}" Margin="0,0,12,0"/>
                        <StackPanel>
                          <TextBlock Text="本地代理" FontWeight="Medium"/>
                          <TextBlock Text="{Binding ProxyDetail}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding ProxyState}" Tag="{Binding ProxyKind}" Style="{StaticResource CheckResult}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Line}" Margin="18,0"/>
                    <Grid Margin="18,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IMonitor}" Margin="0,0,12,0"/>
                        <StackPanel>
                          <TextBlock Text="{Binding ApplicationName}" FontWeight="Medium"/>
                          <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding AppState}" Tag="{Binding AppKind}" Style="{StaticResource CheckResult}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Line}" Margin="18,0"/>
                    <Grid Margin="18,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IRefresh}" Margin="0,0,12,0"/>
                        <StackPanel>
                          <TextBlock Text="{Binding LaunchStrategyTitle}" FontWeight="Medium"/>
                          <TextBlock Text="{Binding LaunchStrategyDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding LaunchStrategyState}" Tag="{Binding LaunchStrategyKind}" Style="{StaticResource CheckResult}" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="2,17,0,0">
                  <Path Style="{StaticResource Icon}" Data="{StaticResource IInfo}" Width="13" Height="13" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding ProxyScopeNote}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="ApplicationsPage" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=applications}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="30,28,30,30" MaxWidth="1040">
                <Grid Margin="0,0,0,24">
                  <StackPanel><TextBlock Text="你的应用" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding ApplicationCount}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
                  <Button x:Name="AddApplicationButton" Content="＋ 添加应用" Command="{Binding AddApplicationCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Applications}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top" Margin="0,2,16,0"><TextBlock Text="{Binding Monogram}" FontFamily="Segoe UI" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                          <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding LocationLabel}" Foreground="{DynamicResource Secondary}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding RouteLabel}" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="选择应用" Command="{Binding DataContext.SelectApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" MinWidth="86"/>
                            <Button Content="配置" Command="{Binding DataContext.EditApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Margin="0,5,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource Subtle}" CornerRadius="9" Padding="16" Margin="0,7,0,0"><TextBlock Text="支持添加其他 .exe 应用。Electron 应用可使用代理参数；其他程序需要支持代理环境变量。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="21"/></Border>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="DiagnosticsPage" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=diagnostics}" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="30,28" MaxWidth="1040">
                <TextBlock Text="运行诊断" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ApplicationCaption}" Style="{StaticResource Caption}" Margin="0,8,0,24"/>
                <Border Style="{StaticResource Card}" Padding="20">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding StatusBadge}" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding LastChecked}" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding FullCheckCommand}" Style="{StaticResource PrimaryButton}" Content="完整诊断" VerticalAlignment="Center" ToolTip="重新验证代理连接、官方包身份、文件签名与启动能力"/>
                  </Grid>
                </Border>
                <TextBlock Text="启动环境" Style="{StaticResource Section}" Margin="0,26,0,12"/>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Margin="20,17">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="HTTP CONNECT" FontWeight="Medium"/>
                        <TextBlock Text="{Binding ProxyEndpoint}" Style="{StaticResource Caption}" FontFamily="Consolas" Margin="0,5,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding ProxyState}" Tag="{Binding ProxyKind}" Style="{StaticResource CheckResult}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Line}"/>
                    <Grid Margin="20,17">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding ApplicationName}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding AppState}" Tag="{Binding AppKind}" Style="{StaticResource CheckResult}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Line}"/>
                    <Grid Margin="20,17">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding AdapterTitle}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding AdapterDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding AdapterState}" Tag="{Binding AdapterKind}" Style="{StaticResource CheckResult}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Line}"/>
                    <Grid Margin="20,17">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding LocationTitle}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding LocationDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding LocationState}" Tag="{Binding LocationKind}" Style="{StaticResource CheckResult}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Line}"/>
                    <Grid Margin="20,17">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="应用进程" FontWeight="Medium"/>
                      <TextBlock Grid.Column="1" Text="{Binding ProcessState}"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Subtle}" CornerRadius="9" Padding="18" Margin="0,18,0,16">
                  <StackPanel>
                    <TextBlock Text="{Binding DiagnosticCode}" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock Text="{Binding StatusDescription}" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
                <WrapPanel>
                  <Button x:Name="CopyDiagnosticButton" Content="复制诊断摘要" Margin="0,0,10,0"/>
                  <Button Content="打开日志目录" Command="{Binding OpenLogsCommand}"/>
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="LogsPage" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=logs}" Margin="30,25,30,18">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <StackPanel>
                  <TextBlock Text="运行记录" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock Text="查看启动与诊断过程中的本地日志。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
                <Button x:Name="ExportLogsButton" Content="导出日志" HorizontalAlignment="Right" VerticalAlignment="Top"/>
              </Grid>
              <Grid Grid.Row="1" Margin="0,23,0,15">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="112"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LogSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索日志" ToolTip="搜索日志内容 · Ctrl+F" Padding="12,9"/>
                <TextBlock Text="搜索日志…" Margin="13,10,0,0" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" VerticalAlignment="Top">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Search}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding Level}" Margin="10,0,0,0" AutomationProperties.Name="日志级别"/>
                <Button Grid.Column="2" Command="{Binding ReloadLogsCommand}" Content="刷新" Margin="10,0,0,0"/>
              </Grid>
              <TextBlock Grid.Row="2" Text="{Binding LogError}" Visibility="{Binding HasLogError, Converter={StaticResource BoolVisible}}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <Border Grid.Row="3" Style="{StaticResource Card}">
                <Grid>
                  <ListBox x:Name="LogList" ItemsSource="{Binding LogsView}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="运行日志列表">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="B" Background="Transparent">
                                <ContentPresenter/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="B" Property="Background" Value="{DynamicResource Subtle}"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,12">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="70"/>
                              <ColumnDefinition Width="58"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11"/>
                              <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                      <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                      <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="2">
                              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" LineHeight="20"/>
                              <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoMatchingLogs, Converter={StaticResource BoolVisible}}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource ILog}" Width="30" Height="30" Margin="0,0,0,13"/>
                    <TextBlock Text="暂无匹配的日志" HorizontalAlignment="Center" Foreground="{DynamicResource Secondary}"/>
                    <TextBlock Text="尝试刷新，或调整搜索条件" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock Grid.Row="4" Text="{Binding LogSummary}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisible}, ConverterParameter=settings}" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="30,27,30,30" MaxWidth="940">
                <TextBlock Text="偏好设置" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="配置网络连接、外观与应用行为。" Style="{StaticResource Caption}" Margin="0,8,0,25"/>
                <Grid Margin="0,0,0,12">
                  <TextBlock Text="网络代理" FontSize="14" FontWeight="SemiBold"/>
                  <Button x:Name="SavePortButton" Command="{Binding SavePortCommand}" Style="{StaticResource PrimaryButton}" Content="保存更改" HorizontalAlignment="Right" MinHeight="29" Padding="12,5"/>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="20,17">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="126"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="默认代理端口" FontWeight="Medium"/>
                        <TextBlock Text="HTTP / Mixed 监听端口" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                      </StackPanel>
                      <TextBox Grid.Column="1" x:Name="PortInput" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" FontFamily="Consolas" FontSize="15" VerticalContentAlignment="Center" AutomationProperties.Name="本地代理端口"/>
                    </Grid>
                    <TextBlock Text="{Binding PortError}" Visibility="{Binding HasPortError, Converter={StaticResource BoolVisible}}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border Background="{DynamicResource Subtle}" CornerRadius="6" Padding="10,8" Margin="0,5,0,0">
                      <TextBlock Text="{Binding PortPreview}" FontFamily="Consolas" Foreground="{DynamicResource Secondary}" FontSize="12"/>
                    </Border>
                    <TextBlock Text="保存后对使用默认端口的应用生效。独立端口可在各应用的设置中修改，正在运行的应用需要退出后重新启动。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,11,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="外观" Style="{StaticResource Section}" Margin="0,25,0,12"/>
                <Border Style="{StaticResource Card}" Padding="20,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="主题" FontWeight="Medium"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Subtle}" CornerRadius="8" Padding="2">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LightThemeButton" Style="{StaticResource Segment}" GroupName="theme" IsChecked="{Binding Theme, Converter={StaticResource Equal}, ConverterParameter=light, Mode=OneWay}" Command="{Binding ThemeCommand}" CommandParameter="light" Content="浅色" AutomationProperties.Name="浅色主题"/>
                        <RadioButton x:Name="DarkThemeButton" Style="{StaticResource Segment}" GroupName="theme" IsChecked="{Binding Theme, Converter={StaticResource Equal}, ConverterParameter=dark, Mode=OneWay}" Command="{Binding ThemeCommand}" CommandParameter="dark" Content="深色" AutomationProperties.Name="深色主题"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="theme" IsChecked="{Binding Theme, Converter={StaticResource Equal}, ConverterParameter=system, Mode=OneWay}" Command="{Binding ThemeCommand}" CommandParameter="system" Content="跟随系统" AutomationProperties.Name="跟随系统主题"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
                <TextBlock Text="运行行为" Style="{StaticResource Section}" Margin="0,25,0,12"/>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Margin="20,17">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="登录 Windows 后自动运行" FontWeight="Medium"/>
                        <TextBlock Text="在托盘启动监控，需要时再打开应用" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                      </StackPanel>
                      <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding StartupEnabled}" VerticalAlignment="Center" AutomationProperties.Name="登录 Windows 后自动运行"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Line}"/>
                    <Grid Margin="20,17">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="关闭窗口后留在托盘" FontWeight="Medium"/>
                        <TextBlock Text="可从托盘菜单重新打开或完全退出" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                      </StackPanel>
                      <CheckBox x:Name="CloseToTrayToggle" Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center" AutomationProperties.Name="关闭窗口后留在托盘"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Line}"/>
                    <Grid Margin="20,17">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="自动检测连接状态" FontWeight="Medium"/>
                        <TextBlock Text="每 15 秒检查代理与 Codex 的运行状态" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                      </StackPanel>
                      <CheckBox x:Name="AutoRefreshToggle" Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center" AutomationProperties.Name="自动检测连接状态"/>
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Text="关于" Style="{StaticResource Section}" Margin="0,25,0,12"/>
                <Border Style="{StaticResource Card}" Padding="20,18">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="Codex Proxy" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Version, StringFormat=版本 {0}}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Codex、Cursor、Grok Bot 与更多桌面应用的代理启动器。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="社区维护的非官方工具。应用名称与相关标识归其权利人所有。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,16"/>
                    <WrapPanel>
                      <Button Command="{Binding OpenLogsCommand}" Content="打开日志目录" Margin="0,0,10,0"/>
                      <Button Command="{Binding ExitCommand}" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Danger}" Content="退出 Codex Proxy"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Canvas}">
            <Grid Margin="22,0">
              <TextBlock Text="{Binding LastChecked}" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Center"/>
              <TextBlock x:Name="MonitorFooter" Text="{Binding MonitorText}" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,0,20,16" Padding="14,12" VerticalAlignment="Bottom" HorizontalAlignment="Right" MaxWidth="540" Panel.ZIndex="20" Visibility="{Binding HasToast, Converter={StaticResource BoolVisible}}">
            <Border.Effect>
              <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.16"/>
            </Border.Effect>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,12,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ToastKind}" Value="error">
                        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ToastKind}" Value="success">
                        <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Button Grid.Column="1" Command="{Binding DismissToastCommand}" Style="{StaticResource GhostButton}" Content="×" Padding="4,0" MinHeight="22" AutomationProperties.Name="关闭提示" VerticalAlignment="Top"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
